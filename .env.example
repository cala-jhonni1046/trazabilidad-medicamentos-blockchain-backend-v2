# Plantilla de variables de entorno de MediChain.
# Copiala a .env (que NUNCA va a Git) y reemplazá cada valor de ejemplo.
# La leen ./levantar.sh y ./reset-demo.sh con: set -a; source .env; set +a
# Todos los valores de acá son FALSOS a propósito.

# --- Base de datos (obligatorias) ---
DB_URL=jdbc:postgresql://localhost:5432/medichain
DB_USER=medichain
DB_PASSWORD=cambiar-por-una-contrasena-fuerte

# --- JWT (obligatoria): al menos 256 bits. Generala con: openssl rand -base64 48 ---
JWT_SECRET=reemplazar-por-la-salida-de-openssl-rand-base64-48

# --- Usuario inicial SEDE_CENTRAL (opcionales: sin ellas no se crea y se avisa en el log) ---
ADMIN_EMAIL=sede@medichain.local
ADMIN_PASSWORD=cambiar-esta-clave

# --- Datos de demo (opcional): solo con SPRING_PROFILES_ACTIVE=demo ---
SPRING_PROFILES_ACTIVE=demo
DEMO_PASSWORD=cambiar-esta-clave-demo

# --- Documentos de habilitación (obligatoria): carpeta FUERA del repo ---
DOCUMENTOS_DIR=/home/usuario/medichain-documentos

# --- Anclaje en Ethereum Sepolia (opcional; apagado por defecto) ---
# Con ANCLAJE_HABILITADO=true las tres siguientes son obligatorias (contracts/GUIA-DESPLIEGUE.md).
ANCLAJE_HABILITADO=false
# URL del nodo RPC: lleva la API key, es SECRETA.
SEPOLIA_RPC_URL=
# Clave privada de la billetera dueña del contrato: SECRETA. Usá una billetera solo de pruebas.
WALLET_PRIVATE_KEY=
# Dirección del contrato MediChainAnchor desplegado (pública).
ANCHOR_CONTRACT_ADDRESS=
